# Copy to .env.local for development. On Vercel, set the same names in the project settings.

# Neon Postgres, pooled connection string. Locally this is the `development` branch, never the live database:
# the live address is kept only in Vercel, and a production deploy applies new migrations there (scripts/migrate.mjs).
DATABASE_URL=

# Better Auth: a random secret (openssl rand -base64 32) and the site's own address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LinkedIn app with "Sign In with LinkedIn using OpenID Connect".
# Redirect URL to register: <BETTER_AUTH_URL>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# The Club's private Lichess team: its id (the last part of lichess.org/team/<id>) and its join password.
# Members are added with their own Lichess permission and this password, which they never see.
# Lichess sends people back to <BETTER_AUTH_URL>/api/lichess/callback; nothing needs registering with Lichess.
LICHESS_TEAM_ID=
LICHESS_TEAM_PASSWORD=

# Optional: the Organiser's email address. When set (and a valid address), every page's footer links to it and the
# sign-in notice says data can be deleted on request; when unset, the site shows no contact route.
ORGANISER_CONTACT_EMAIL=

# Development and tests only: talk to a fake Lichess at this address. Ignored in production.
# LICHESS_URL=http://localhost:8089
