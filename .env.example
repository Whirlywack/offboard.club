# Copy to .env.local for development. On Vercel, set the same names in the project settings.

# Neon Postgres, pooled connection string. Locally this is the `development` branch, never the live database:
# the live address is kept only in Vercel, and a production deploy applies new migrations there (scripts/migrate.mjs).
DATABASE_URL=

# Better Auth: a random secret (openssl rand -base64 32) and the site's own address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LinkedIn app with "Sign In with LinkedIn using OpenID Connect".
# Redirect URL to register: <BETTER_AUTH_URL>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# The Club's private Lichess team: its id (the last part of lichess.org/team/<id>) and its join password.
# Members are added with their own Lichess permission and this password, which they never see.
# Lichess sends people back to <BETTER_AUTH_URL>/api/lichess/callback (the Organiser to .../organiser-callback);
# nothing needs registering with Lichess.
LICHESS_TEAM_ID=
LICHESS_TEAM_PASSWORD=

# The Organiser: the person id ("user".id in the database) of the one Member who runs the Club. Only they can open
# /organiser, where they connect the Lichess account that leads the team. Unset, nobody is the Organiser.
ORGANISER_USER_ID=

# Optional: the Organiser's email address. When set (and a valid address), every page's footer links to it and the
# sign-in notice says data can be deleted on request; when unset, the site shows no contact route.
ORGANISER_CONTACT_EMAIL=

# The key that encrypts the Organiser's Lichess token in the database: 32 random bytes (openssl rand -base64 32).
# Changing it makes the stored token unreadable: Matchdays stop being created until the Organiser connects Lichess
# again, and the site can no longer revoke the old permission, which stays valid on Lichess for up to a year. Before
# connecting again, revoke it by hand: signed in to Lichess as that account, Security in its settings
# (lichess.org/account/security), revoke Offboard among the third-party apps.
LICHESS_TOKEN_KEY=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" with each scheduled job (vercel.json); anything else is
# refused. Vercel recommends at least 16 characters, and the site refuses every run with a shorter one, or none: use
# letters and digits only (openssl rand -hex 32).
CRON_SECRET=

# The Club's Telegram group. The site posts nothing, and shows no Member an invite link, until these are set.
# The bot's token, as Telegram's @BotFather gives it when the bot is made.
TELEGRAM_BOT_TOKEN=
# The group's chat id (a number such as -1001234567890), or its @username if it has one; the bot must be in the group.
TELEGRAM_GROUP_ID=
# The group's invite link (https://t.me/+...), shown only to signed-in Members.
TELEGRAM_INVITE_LINK=

# Development and tests only: talk to a fake Lichess at this address. Ignored in production.
# LICHESS_URL=http://localhost:8089
# Development and tests only: talk to a fake Telegram at this address (pnpm fake-telegram). Ignored in production.
# TELEGRAM_URL=http://127.0.0.1:8189
