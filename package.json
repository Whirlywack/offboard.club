{
  "name": "offboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --on-deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:cookies": "tsx --env-file-if-exists=.env.local scripts/seed.ts --cookies",
    "fake-lichess": "tsx --env-file-if-exists=.env.local scripts/fake-lichess.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.27",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.0.8"
}
